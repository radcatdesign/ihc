 "headline": "“I’ll never forget this day.” - Attendee",
 "intro": "A LIVING DREAM DINNER COLLABORATION!",
 "introPieces": [
  {
   "type": "introGallery",
   "media": [
    {
     "type": "image",
     "src": "/images/6a175173876668f21ab5259f_pixar_DPdinner_photo-by-meghanmcneer_120-p-2000.avif",
